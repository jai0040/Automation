# Base URL of the CampusDean staging environment
BASE_URL=https://staging.campusdean.com

# Login route relative to BASE_URL
LOGIN_PATH=/Login/Index

# Valid staging credentials for testing (loaded dynamically into tests)
TEST_USERNAME=your_test_username
TEST_PASSWORD=your_test_password

# Invalid credentials used for negative test scenarios
TEST_INVALID_USERNAME=invalid_qa_user_99999
TEST_INVALID_PASSWORD=InvalidPassword#123

# Browser execution mode: true for headless, false for headed
HEADLESS=false
