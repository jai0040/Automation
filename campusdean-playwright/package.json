{
  "name": "campusdean-playwright",
  "version": "1.0.0",
  "description": "Playwright end-to-end automation test suite for CampusDean staging portal",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:login": "playwright test tests/login.spec.js",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "qa",
    "campusdean",
    "e2e"
  ],
  "author": "Senior QA Automation Engineer",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "dotenv": "^16.4.7"
  }
}
